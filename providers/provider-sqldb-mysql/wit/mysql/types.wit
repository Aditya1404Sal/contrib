package bettyblocks:mysql@1.0.0;

interface types {
    /// Errors that occur while executing queries
  variant query-error {
    /// Unknown/invalid query parameters
    invalid-params(string),
    /// Invalid/malformed query
    invalid-query(string),
    /// A completely unexpected error, specific to executing queries
    unexpected(string),
  }

  /// Errors that occur while preparing a statement
  variant statement-prepare-error {
    /// A completely unexpected error
    unexpected(string),
  }

  /// Errors that occur during prepared statement execution
  variant prepared-statement-exec-error {
    /// Unknown/invalid prepared statement token
    unknown-prepared-query,
    /// An otherwise known query execution error
    query-error(query-error),
    /// A completely unexpected error, specific to prepared statements
    unexpected(string),
  }

  type hashable-f64 = tuple<u64, s16, s8>;
  type hashable-f32 = hashable-f64;

  type column-name = string;

  /// Arbitrary Precision metric
  type decimal = string;

  type mysql-set = list<string>;

  type mysql-enum = string;

  record mysql-date {
    year : u32,
    month : u32,
    day : u32
  }
  /// Time can be negative according to mysql crate [https://docs.rs/mysql/latest/mysql/enum.Value.html#variant.Time]
  record mysql-time {
    isnegative : bool,
    hour : u32,
    minute : u32,
    second : u32, 
    microsecond : u32,
  }

  record mysql-datetime {
    date : mysql-date,
    time : mysql-time,
  }

  /// Mysql Timestamp is internal, UTC auto-conversion is done according to db config set timezone.
  record mysql-timestamp {
    datetime: mysql-datetime,
  }

  /// Year value (range 1901–2155).
  variant mysql-year {
    year-two(u8),
    year-four(u32),
  }

  variant mysql-value {
    null,
    // Numeric Types
    /// TINYINT[(M)] [UNSIGNED] - 1 byte integer (-128 to 127)
    tinyint(s8),
    /// TINYINT UNSIGNED - 1 byte integer (0 to 255)
    tinyint-unsigned(u8),
    
    /// SMALLINT[(M)] [UNSIGNED] - 2 byte integer (-32,768 to 32,767)
    smallint(s16),
    /// SMALLINT UNSIGNED - 2 byte integer (0 to 65,535)
    smallint-unsigned(u16),
    
    /// MEDIUMINT[(M)] [UNSIGNED] - 3 byte integer (-8,388,608 to 8,388,607)
    mediumint(s32),
    /// MEDIUMINT UNSIGNED - 3 byte integer (0 to 16,777,215)
    mediumint-unsigned(u32),
    
    /// INT[(M)] / INTEGER[(M)] [UNSIGNED] - 4 byte integer (-2,147,483,648 to 2,147,483,647)
    int(s32), 
    integer(s32),
    /// INT/INTEGER UNSIGNED - 4 byte integer (0 to 4,294,967,295)
    int-unsigned(u32),
    integer-unsigned(u32),
    
    /// BIGINT[(M)] [UNSIGNED] - 8 byte integer (-9,223,372,036,854,775,808 to 9,223,372,036,854,775,807)
    bigint(s64),
    /// BIGINT UNSIGNED - 8 byte integer (0 to 18,446,744,073,709,551,615)
    bigint-unsigned(u64),

    /// DECIMAL(M[,D])/NUMERIC(M[,D]) [UNSIGNED] - Fixed point, up to 65 digits
    decimal(decimal),
    numeric(decimal),

    /// FLOAT[(M,D)] [UNSIGNED] - Single-precision floating point
    float(hashable-f32),

    /// DOUBLE[(M,D)] / REAL[(M,D)] [UNSIGNED] - Double-precision floating point
    double(hashable-f64),
    real(hashable-f64),

    /// BIT[(M)] - Bit-field (default 1, max 64 bits)
    bit(tuple<u8, list<u8>>),

    // Date and Time Types
    /// DATE - 'YYYY-MM-DD'
    date(mysql-date),
    
    /// TIME[(fsp)] - '[hh:mm:ss[.fraction]]', fsp: 0–6
    time(mysql-time),
    
    /// DATETIME[(fsp)] - 'YYYY-MM-DD hh:mm:ss[.fraction]', fsp: 0–6
    datetime(mysql-datetime),
    
    /// TIMESTAMP[(fsp)] - Same as DATETIME; stored UTC, auto-convert
    timestamp(mysql-timestamp),
    
    /// YEAR[(2|4)] - Year value (range 1901–2155)
    year(mysql-year),

    // String and Binary Types
    /// CHAR(M) - Fixed length string (0–255 chars)
    %char(tuple<u32, string>),
    
    /// VARCHAR(M) - Variable length string (0–65,535 chars)
    varchar(tuple<u32, string>),
    
    /// BINARY(M) - Fixed binary (0–255 bytes)
    binary(tuple<u32, list<u8>>),
    
    /// VARBINARY(M) - Variable binary (0–65,535 bytes)
    varbinary(tuple<u32, list<u8>>),

    // Blob/Text Types
    /// TINYBLOB / TINYTEXT - Max 255 bytes/chars
    tinyblob(list<u8>),
    tinytext(string),
    
    /// BLOB / TEXT - Max 65,535 bytes/characters
    blob(list<u8>),
    text(string),
    
    /// MEDIUMBLOB / MEDIUMTEXT - Max 16,777,215 bytes/characters
    mediumblob(list<u8>),
    mediumtext(string),
    
    /// LONGBLOB / LONGTEXT - Max 4,294,967,295 bytes/characters
    longblob(list<u8>),
    longtext(string),

    // Set Types
    /// ENUM('value1',...) - One value from set
    mysql-enum(mysql-enum),
    
    /// SET('value1',...) - Zero or more values from set
    mysql-set(mysql-set),

    // Spatial Types
    /// GEOMETRY - Any spatial value
    geometry(list<u8>),
    
    /// POINT - Single x,y coordinate
    point-geom(list<u8>),
    
    /// LINESTRING - Series of points forming a line
    linestring(list<u8>),
    
    /// POLYGON - Closed area defined by points
    polygon(list<u8>),
    
    /// MULTIPOINT - Multiple POINT values
    multipoint(list<u8>),
    
    /// MULTILINESTRING - Multiple LINESTRINGs
    multilinestring(list<u8>),
    
    /// MULTIPOLYGON - Multiple POLYGONs
    multipolygon(list<u8>),
    
    /// GEOMETRYCOLLECTION - Collection of spatial objects
    geometrycollection(list<u8>),

    // Other Types
    /// JSON - Native JSON storage/query support
    json(string),
    
    /// BOOL, BOOLEAN - Synonyms for TINYINT(1)
    boolean(bool),
  }
  record result-row-entry {
    column-name : string,
    value : mysql-value,
  }

  type result-row = list<result-row-entry>;
}